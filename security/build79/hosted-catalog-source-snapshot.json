      "expression": "CHECK (notify_target = ANY (ARRAY['assigned_recruiter'::text, 'role:admin'::text, 'role:recruiter'::text, 'role:operations'::text, 'role:finance'::text, 'role:viewer'::text]))"
    },
    {
      "table": "workflow_rules",
      "constraint": "workflow_rules_table_name_check",
