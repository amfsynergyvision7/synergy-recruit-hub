echo '{
    "buildCommand": "npm run build",
    "outputDirectory": "dist/client",
    "installCommand": "npm install",
    "framework": null,
    "routes": [
      { "src": "/assets/(.*)", "dest": "/assets/$1" },
      { "src": "/(.*)", "dest": "/index.html" }
    ]
  }' > vercel.json && cat vercel.json